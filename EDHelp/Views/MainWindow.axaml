<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EDHelp.ViewModels"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        x:Class="EDHelp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EDHelp - Deck Builder"
        Width="1400" Height="900">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Import Deck..." Command="{Binding ImportDeckCommand}" CommandParameter="{Binding $self}"/>
                <Separator/>
                <MenuItem Header="_Exit"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid>
            <!-- Dock Layout -->
            <dock:DockControl Layout="{Binding Layout}" 
                              IsVisible="{Binding IsDeckLoaded}"/>
            
            <!-- Import View (shown when no deck loaded) -->
            <Border Background="#1e1e1e" 
                    IsVisible="{Binding !IsDeckLoaded}">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Spacing="20">
                    <TextBlock Text="📄" 
                               FontSize="72" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop a decklist (.txt) file here" 
                               FontSize="18" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="or" 
                               FontSize="14" 
                               Foreground="#888"
                               HorizontalAlignment="Center"/>
                    <Button Content="Browse Files..." 
                            Command="{Binding ImportDeckCommand}"
                            CommandParameter="{Binding $self}"
                            HorizontalAlignment="Center"
                            Padding="20,10"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>