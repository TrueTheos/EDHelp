<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EDHelp.ViewModels.Tools"
             x:Class="EDHelp.Views.Tools.CommonCardsView"
             x:DataType="vm:CommonCardsViewModel">

    <Design.DataContext>
        <vm:CommonCardsViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#505050"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Common Cards"
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="White"
                   Margin="10,10,10,5"/>

        <ScrollViewer Grid.Row="1" Margin="10,0,10,10">
            <ItemsControl ItemsSource="{Binding CommonCards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                Margin="0,0,0,1"
                                Padding="8,6"
                                CornerRadius="3">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Style>
                            </Border.Styles>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Quantity -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Quantity}" 
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#cccccc"
                                           Width="30"
                                           TextAlignment="Left"
                                           VerticalAlignment="Center"/>
                                
                                <!-- Card Name -->
                                <Button Grid.Column="1" 
                                        Content="{Binding card.name}"
                                        Foreground="White"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Left"
                                        Padding="0"
                                        Command="{Binding $parent[UserControl].((vm:CommonCardsViewModel)DataContext).ShowCardDetailsCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True" 
                     IsVisible="{Binding IsLoading}" 
                     VerticalAlignment="Center" 
                     HorizontalAlignment="Center"
                     Width="200"/>
    </Grid>
</UserControl>