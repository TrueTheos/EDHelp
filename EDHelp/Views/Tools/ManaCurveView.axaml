<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EDHelp.ViewModels.Tools"
             xmlns:controls="using:EDHelp.Controls"
             x:Class="EDHelp.Views.Tools.ManaCurveView"
             x:DataType="vm:ManaCurveViewModel">

    <Design.DataContext>
        <vm:ManaCurveViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Mana Curve" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="White" 
                   Margin="10,10,10,5"/>

        <controls:ManaCurveChart Grid.Row="1" 
                                 ManaCurve="{Binding ManaCurve}"
                                 Margin="10,0,10,10"/>
    </Grid>
</UserControl>